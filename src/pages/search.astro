---
import Base from "../layouts/Base.astro";
import Lang from "../components/Lang.astro";
import { both } from "../i18n";

const heading = both("search");
const noscript = both("searchNoscript");
const placeholder = both("searchPlaceholder");
---
<Base title="Search" description="Search the blog">
  <section class="intro">
    <h1><Lang en={heading.en} zh={heading.zh} /></h1>
  </section>
  <div
    class="search-shell"
    id="search"
    data-placeholder-en={placeholder.en}
    data-placeholder-zh={placeholder.zh}
  ></div>
  <p class="search-hint" id="search-hint" hidden>
    <Lang
      en="The search index is only generated by a build: run npm run build (it runs Pagefind) and preview dist/."
      zh="搜索索引只存在于构建产物里：执行 npm run build（会自动跑 Pagefind），再预览 dist/。"
    />
  </p>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script>
    const currentLang = () => (document.documentElement.dataset.lang === "zh" ? "zh" : "en");
    let mounted: string | null = null;

    const showHint = () => {
      const hint = document.getElementById("search-hint");
      if (hint) hint.hidden = false;
    };

    const mount = () => {
      const target = document.getElementById("search");
      const PagefindUI = (window as any).PagefindUI;
      const lang = currentLang();
      if (!target || !PagefindUI || mounted === lang) return;
      target.innerHTML = "";
      document.getElementById("search-hint")?.setAttribute("hidden", "");
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: lang === "zh" ? target.dataset.placeholderZh : target.dataset.placeholderEn,
        },
      });
      mounted = lang;
    };

    const ui = document.querySelector('script[src="/pagefind/pagefind-ui.js"]');
    // `npm run dev` has no /pagefind/ directory — say so instead of showing an empty box.
    ui?.addEventListener("error", showHint);

    if ((window as any).PagefindUI) {
      mount();
    } else {
      ui?.addEventListener("load", mount);
      setTimeout(() => {
        if (!document.querySelector(".pagefind-ui")) showHint();
      }, 1500);
    }

    // Pagefind derives its own strings from <html lang>, so re-mount on a switch.
    document.addEventListener("langchange", mount);
  </script>
  <noscript>
    <p>
      <Lang en={noscript.en} zh={noscript.zh} />
      <a href="/blog/"><Lang en="all posts" zh="全部文章" /></a>.
    </p>
  </noscript>
</Base>
